# Copy to .env and fill in. Never commit .env.

# Team OpenRouter key. Leave empty to run in mock mode (free, fake agents).
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models
LLM_MODEL=openai/gpt-5-mini

# gpt-5 models think before answering, and thinking tokens are billed as output.
# minimal | low | medium | high. Leave empty for models without reasoning.
LLM_REASONING_EFFORT=low

# Upper limit per call. Thinking tokens count, so do not set this too low.
LLM_MAX_TOKENS=1500

# 1 = never call the API (fake agents, for UI work and for checking the flow)
LLM_MOCK=0

# Price per 1M tokens, used only for the cost estimate printed by the test scripts
LLM_PRICE_IN=0.25
LLM_PRICE_OUT=2.0

# Optional. Another OpenAI-compatible server, e.g. local Ollama: http://localhost:11434/v1
# LLM_BASE_URL=

# Optional. gpt-5 models reject a custom temperature, so leave this unset for them.
# LLM_TEMPERATURE=0.2

# API server port
PORT=8787
